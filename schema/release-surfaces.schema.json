{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathanPorta/kioskit-publish/schema/release-surfaces.schema.json",
  "title": "release-surfaces.yaml (blessed/release-surfaces/v1, as declared by this repository)",
  "description": "Repository-authored structural contract for this repository's surface declaration, written from blessed releases.surfaces@1 (proposal v1): the universal surface fields, the closed publisher-model and promotion-transport vocabularies, and the public-github-mirror rule that operational download fields are absent. blessed's own schema lives in a private category that a public repository may not republish, so this is not a copy of it; with BLESSED_CICD_DIR set, test/surfaces.test.sh also runs blessed's validate-surfaces.sh. Validated offline by the signed public validator scripts/release/lib/lib-json-schema.sh.",
  "type": "object",
  "required": ["schema", "product", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "blessed/release-surfaces/v1" },
    "product": { "$ref": "#/$defs/token" },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repo": {
      "description": "GitHub owner/name: owner is 1-39 alphanumerics with single inner hyphens; name is 1-100 of [A-Za-z0-9._-], not '.' or '..'.",
      "type": "string",
      "pattern": "^(?=[^/]{1,39}/)[A-Za-z0-9](-?[A-Za-z0-9])*/(?!\\.\\.?$)[A-Za-z0-9._-]{1,100}$"
    },
    "tokenList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "surface": {
      "type": "object",
      "required": ["id", "kind", "owner_repo", "producer_repos", "consumer_contract", "access_model"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "kind": {
          "enum": [
            "public-download-surface",
            "public-github-mirror",
            "runtime-artifact-surface",
            "runtime-deploy",
            "registry-store-surface",
            "product-release-bom",
            "package-repository-surface"
          ]
        },
        "owner_repo": { "$ref": "#/$defs/repo" },
        "producer_repos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repo" } },
        "consumer_contract": { "$ref": "#/$defs/tokenList" },
        "access_model": { "$ref": "#/$defs/token" },
        "publisher_model": { "enum": ["surface-pull"] },
        "promotion_transport": { "enum": ["repository_dispatch", "workflow_dispatch"] },
        "public_base_url": { "type": "string" },
        "package_formats": { "type": "array" },
        "immutable_release_prefix": { "type": "string" },
        "promotion_outputs": { "type": "array" }
      },
      "allOf": [
        {
          "description": "A public-github-mirror is declaration-shape only in v1: none of the download-surface operational fields.",
          "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "public-github-mirror" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["public_base_url"] },
                { "required": ["package_formats"] },
                { "required": ["immutable_release_prefix"] },
                { "required": ["promotion_outputs"] }
              ]
            }
          }
        }
      ]
    }
  }
}
