{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathanPorta/kioskit-publish/schema/blessed-repo.schema.json",
  "title": "blessed.yml (blessed/repo/v1, as declared by this repository)",
  "description": "Repository-authored structural contract for this repository's root blessed.yml, written from blessed-cicd's repo manifest contract (templates/blessed.yml; the catalog collector's manifest rules) and the catalog vocabularies at blessed-cicd 81694f5 (catalog/repo-types.yml, stages.yml, capabilities.yml; standards/registry.yml ids). blessed's own validator is private; with BLESSED_CICD_DIR set, test/blessed-manifest.test.sh also runs it. Validated offline by the signed public validator scripts/release/lib/lib-json-schema.sh.",
  "type": "object",
  "required": ["schema", "project", "component", "repo_type", "stage", "stack", "standards", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "blessed/repo/v1" },
    "project": { "$ref": "#/$defs/slug" },
    "component": { "$ref": "#/$defs/slug" },
    "repo_type": {
      "enum": ["standards-repo", "static-site", "github-pages-site", "cloudflare-worker", "desktop-app", "browser-extension", "mobile-app", "cli", "library", "terraform-module", "docs-only", "container-image", "service-api", "daemon", "infra"]
    },
    "stage": { "enum": ["spike", "prototype", "active", "production", "maintenance", "paused", "archived"] },
    "stack": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "standards": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/standardRef" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
    "tracked_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai_rules": {
          "type": "object",
          "required": ["origin", "tag"],
          "additionalProperties": false,
          "properties": {
            "origin": { "const": "https://github.com/JonathanPorta/ai-rules" },
            "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        },
        "blessed_scripts": {
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
        }
      }
    },
    "waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "exceptions": { "type": "array", "maxItems": 0 },
    "notes": { "type": "string" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "standardRef": {
      "type": "string",
      "pattern": "^(catalog\\.(adoption|backstage-compatibility|cost-infra-traction|generated-files|project-awareness|project-component-example|repo-types|stages)|change-authority\\.core|github-actions\\.(audit-artifact-contract|dependabot-secret-guards|secret-boundaries)|human-change-authority|makefile\\.(capability-verbs|core|migration|profiles)|releases\\.(app-gated|apple-distribution|candidate|chrome-web-store|linux-packaging|package-repositories|pipeline|promotion-handshake|release-pr|runtime-update|surfaces|windows-distribution)|reviews\\.console|secrets\\.(bwsm-authority-domains|bwsm-ci-loader)|signing\\.(apple-macos|apple-mobile|ed25519-detached|native-application|tauri-minisign|windows)|spec-pack\\.(adoption|core|profiles)|standards\\.(frontmatter|lifecycle|registry|review|source-of-truth)|static-sites\\.(branch-promotion|deployment-variants)|tracked-artifacts)@[0-9]+$"
    },
    "capability": {
      "enum": ["bwsm", "ruam", "repo-protection", "sha-pinning", "ai-rules-subtree", "blessed-scripts", "declared-capability", "slack-router", "package", "release-github", "release-candidate-producer", "static-site-terraform", "cloudflare-worker", "embedded-web-ui", "icons"]
    },
    "waiver": {
      "description": "policies/tracked-artifacts.md waiver shape: active only with reason, owner and review_by. It names the standard, or the adoption-policy capability, it scopes.",
      "type": "object",
      "required": ["check", "reason", "owner", "review_by"],
      "additionalProperties": false,
      "properties": {
        "standard": { "$ref": "#/$defs/standardRef" },
        "capability": { "$ref": "#/$defs/capability" },
        "check": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "reason": { "type": "string", "minLength": 20 },
        "owner": { "type": "string", "minLength": 1 },
        "review_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "max_age_days": { "type": "integer", "minimum": 1, "maximum": 180 }
      },
      "oneOf": [
        { "required": ["standard"], "not": { "required": ["capability"] } },
        { "required": ["capability"], "not": { "required": ["standard"] } }
      ]
    }
  }
}
